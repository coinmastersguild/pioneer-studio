{
  "name": "pioneer-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source AI production studio powered by the Pioneer API",
  "license": "AGPL-3.0-only",
  "homepage": "https://studio.pioneers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/coinmastersguild/pioneer-studio.git"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "dev": "bun run setup && vite",
    "build": "bun run setup && tsc -b && vite build",
    "lint": "oxlint",
    "test": "bun run setup && bun test src scripts/meshy2vrm.test.mjs",
    "check": "bun run lint && bun run test && bun run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.7",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
